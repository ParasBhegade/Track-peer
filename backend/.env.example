# ========================
# Database
# ========================
DATABASE_URL=postgresql+asyncpg://habittracker:habittracker_dev@localhost:5433/habittracker

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379/0

# ========================
# Security (generate your own!)
# ========================
JWT_SECRET=CHANGE-ME-generate-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================
# CORS
# ========================
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# ========================
# Email (Mailpit in dev)
# ========================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@habittracker.dev

# ========================
# Google OAuth
# ========================
GOOGLE_CLIENT_ID=your-google-client-id

# ========================
# App
# ========================
APP_ENV=development
DEBUG=true
